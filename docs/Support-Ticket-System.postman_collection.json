                "{{ticketId}}",
                "comments"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"comment\": \"Investigating root cause...\", \"isInternalNote\": false}"
            }
          }
        },
        {
          "name": "Get Comments",
          "request": {
            "method": "GET",
            "header": [
              {
