{
  "info": {
    "name": "Support Ticket System",
    "_postman_id": "support-ticket-system-collection",
    "description": "Postman collection for the Support Ticket System API. Covers authentication, ticket lifecycle (create, assign, status update, comment, close), history, and troubleshooting.\n\nBase URL: http://localhost:5000\n\nSetup:\n1. Set the baseUrl variable to your server (default: http://localhost:5000)\n2. Log in as a user to obtain an accessToken\n3. Set the accessToken variable\n4. Use requests in order: Login -> Create -> Assign -> Status -> Comment -> Close",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"ccexec@test.com\", \"password\": \"Password123\"}"
            }
          }
        }
      ]
    },
    {
      "name": "2. Ticket Lifecycle",
      "item": [
        {
          "name": "Create Ticket",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/support/tickets",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "support",
                "tickets"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"subject\": \"Website down\", \"departmentId\": \"6adefc9f0dda706b15e57fa8\", \"priority\": \"high\"}"
            }
          }
        },
        {
          "name": "View All Tickets (Scope-Filtered)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/support/tickets/all",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "support",
                "tickets",
                "all"
              ]
            }
          }
        },
        {
          "name": "View Department Tickets (Manager)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/support/tickets/manager",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "support",
                "tickets",
                "manager"
              ]
            }
          }
        },
        {
          "name": "Get One Department Ticket (Manager)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/support/tickets/manager/{{ticketId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "support",
                "tickets",
                "manager",
                "{{ticketId}}"
