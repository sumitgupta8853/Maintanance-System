                "tickets",
                "{{ticketId}}"
              ]
            }
          }
        },
        {
          "name": "Edit Ticket Fields",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/support/tickets/{{ticketId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "support",
                "tickets",
                "{{ticketId}}"
