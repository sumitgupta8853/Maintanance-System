                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "support",
                "tickets",
                "manager",
                "{{ticketId}}",
                "assign"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"assignedTo\": \"6adf180c5f26bc843c6e9d8f\"}"
            }
          }
        },
        {
          "name": "View Team Tickets (Engineer)",
