              ]
            }
          }
        },
        {
          "name": "Close Ticket (Technical Manager / Engineer)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/support/tickets/{{ticketId}}/close",
